<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Gambar Utama yang Menutupi Seluruh Layar (Sesuai gaya image_392e1b.png) -->
    <ImageView
        android:id="@+id/imgOnboarding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img_4" />

    <!-- 2. Lapisan Gradasi Gelap (Agar tulisan putihnya tajam dan mudah dibaca) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_dark" />

    <!-- 3. Konten Teks dan Kartu di Bagian Bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="120dp"> <!-- Space sengaja agak tinggi untuk area Dots Indicator di bawah -->

        <!-- Kartu Semi Transparan Putih Elegan -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E6FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#33FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <!-- Judul Utama (Menggunakan Biru Tua Tema Aplikasi) -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Judul Onboarding"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/desa_blue_dark"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <!-- Deskripsi Pendukung -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deskripsi lengkap mengenai fitur inventarisasi bina desa."
                    android:gravity="center"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.3" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</FrameLayout>