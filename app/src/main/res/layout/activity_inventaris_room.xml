<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/desa_blue_light">

    <!-- Latar Belakang Biru Gelap di Bagian Atas -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/desa_blue_dark" />

    <!-- Toolbar untuk Navigasi Kembali ke Home -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarInventaris"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Bina Desa - Inventaris"
        app:titleTextColor="@color/white" />

    <!-- Konten Utama menggunakan ScrollView agar Fleksibel -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbarInventaris"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- CardView Form Input Sesuai Tema Login -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="25dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="30dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inventaris Desa (Room Database)"
                        android:textColor="@color/desa_blue_dark"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="20dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNamaAset"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nama Inventaris" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTambah"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="Tambah Data"
                        android:layout_marginTop="20dp"
                        app:backgroundTint="@color/desa_blue_primary"
                        app:cornerRadius="15dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bagian Judul untuk Daftar Data -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar Inventaris"
                android:textColor="@color/desa_blue_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>

            <!-- RecyclerView untuk Menampilkan Data -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerInventaris"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>