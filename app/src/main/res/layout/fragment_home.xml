<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/desa_blue_light">


    <ScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottom_navigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Halo Admin Aset,"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/desa_blue_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kelola infrastruktur desa dengan mudah."
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="25dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn1"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="Kalkulator Luas Aset"
                        app:backgroundTint="@color/desa_blue_primary"
                        app:cornerRadius="12dp"
                        android:textAllCaps="false"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn2"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="Katalog Aset"
                        app:backgroundTint="@color/desa_blue_primary"
                        app:cornerRadius="12dp"
                        android:textAllCaps="false"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWelcome"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="Detail Aset Publik"
                        app:backgroundTint="@color/desa_blue_primary"
                        app:cornerRadius="12dp"
                        android:textAllCaps="false"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn3"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="Buka Website Bina Desa"
                        app:backgroundTint="@color/desa_accent"
                        app:cornerRadius="12dp"
                        android:textAllCaps="false"
                        android:textColor="@color/desa_blue_dark" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:text="Keluar Sistem"
                app:backgroundTint="#D32F2F"
                app:cornerRadius="12dp"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>