<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/desa_blue_light">

    <!-- ViewPager untuk Slide Konten - DIUBAH agar fullscreen -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <!-- Atribut android:layout_above="@id/bottomContainer" DIHAPUS -->

    <!-- Kontainer Bawah untuk Dots dan Tombol - Melayang di atas gambar -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingBottom="36dp">

        <!-- Dots Indicator -->
        <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
            android:id="@+id/dot_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:dotsColor="@color/desa_blue_dark"
            app:dotsCornerRadius="10dp"
            android:layout_marginBottom="16dp"
            app:dotsSpacing="5dp"
            app:progressMode="true"
            app:selectedDotColor="#96211C1C" />
        <!-- Hapus atribut ConstraintLayout (app:layout_constraint...) karena ini di RelativeLayout -->

        <!-- Tombol Mulai -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMulai"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Mulai Jelajahi Desa"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            app:backgroundTint="@color/desa_blue_primary"
            app:cornerRadius="28dp"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            android:visibility="gone"/>

    </LinearLayout>

</RelativeLayout>